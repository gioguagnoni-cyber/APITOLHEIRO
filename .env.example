# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_ nestas variáveis.
SUPABASE_URL=https://lngivvahbetcujweejim.supabase.co
# Chave moderna sb_secret_...; exclusiva do servidor.
SUPABASE_SECRET_KEY=
# Alternativa de compatibilidade para uma chave service_role JWT legada:
# SUPABASE_SERVICE_ROLE_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Protege o cron da Vercel. Gere um valor aleatório longo.
CRON_SECRET=

# A aplicação preserva uma margem de segurança abaixo do teto gratuito de 100/dia.
API_FOOTBALL_DAILY_LIMIT=90
# Plano gratuito: 10 requisições/minuto. Nove mantém margem para a API.
API_FOOTBALL_MAX_REQUESTS_PER_RUN=9
